{
  "name": "pi-private-credentials",
  "version": "0.3.1",
  "description": "Flexible private TUI form entry and encrypted, origin-bound browser autofill for Pi",
  "type": "module",
  "license": "MIT",
  "keywords": ["pi-package", "pi-extension", "credentials", "autofill", "privacy"],
  "repository": { "type": "git", "url": "git+https://github.com/alexalmny/pi-private-credentials.git" },
  "homepage": "https://github.com/alexalmny/pi-private-credentials#readme",
  "bugs": { "url": "https://github.com/alexalmny/pi-private-credentials/issues" },
  "files": ["src/", "SECURITY.md", "CHANGELOG.md"],
  "publishConfig": { "access": "public" },
  "engines": { "node": ">=22.6" },
  "pi": { "extensions": ["./src/index.ts"] },
  "scripts": { "test": "node --experimental-strip-types --test test/*.test.mjs" },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-tui": "*"
  }
}
